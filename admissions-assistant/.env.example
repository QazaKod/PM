# Security Configuration (Generate via: openssl rand -hex 32)
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ENV=development

# Database Configuration (SQLite for local dev, PostgreSQL for production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admissions_db

# AI Chatbot API Key
GEMINI_API_KEY=

# Telegram Bot Integration for Password Reset & Admissions Notifications
# Leave empty to use default team bot, or provide custom bot token:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=sdu_admissions_registration_bot
# TELEGRAM_MODE=polling  # polling | webhook | worker

# Optional SMTP Configuration (if email channel is preferred)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@sdu.edu.kz
# SMTP_PASSWORD=your_app_password
